    "from transformers import XLMRobertaXLConfig, XLMRobertaXLModel, AutoTokenizer\n",
    "\n",
    "# Load the XLM-Roberta-XL tokenizer and model configuration\n",
    "model_name = \"facebook/xlm-roberta-xxl\"  # Pretrained model name\n",
    "configuration = XLMRobertaXLConfig.from_pretrained(model_name)  # Load pre-trained configuration\n",
    "model = XLMRobertaXLModel.from_pretrained(model_name, config=configuration)  # Load the model\n",
    "tokenizer = AutoTokenizer.from_pretrained(model_name)  # Load tokenizer\n"
