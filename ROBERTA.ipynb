    "from tqdm import tqdm\n",
    "import torch\n",
    "\n",
    "# Function to tokenize and get embeddings\n",
    "def get_embeddings_with_progress(texts, tokenizer, model, device, max_length=512):\n",
    "    \"\"\"\n",
    "    Generate embeddings for a list of texts using XLM-Roberta-XL with progress tracking.\n",
    "\n",
    "    Args:\n",
    "        texts (list): List of input texts.\n",
    "        tokenizer: Hugging Face tokenizer object.\n",
    "        model: Hugging Face model object.\n",
    "        device (torch.device): Device to run inference on (CPU/GPU).\n",
    "        max_length (int): Maximum token length (default: 512).\n",
    "\n",
    "    Returns:\n",
    "        torch.Tensor: Embeddings for input texts.\n",
    "    \"\"\"\n",
    "    embeddings = []\n",
    "\n",
    "    # Ensure the model is in evaluation mode and moved to the correct device\n",
    "    model.eval()\n",
    "    model.to(device)\n",
    "\n",
    "    # Process texts with tqdm for progress tracking\n",
    "    for text in tqdm(texts, desc=\"Generating embeddings\"):\n",
    "        # Tokenize the input text\n",
    "        inputs = tokenizer(\n",
    "            text,\n",
    "            padding=\"max_length\",\n",
    "            truncation=True,\n",
    "            max_length=max_length,\n",
    "            return_tensors=\"pt\"\n",
    "        ).to(device)  # Move inputs to the device\n",
    "\n",
    "        # Get the model's output\n",
    "        with torch.no_grad():\n",
    "            outputs = model(**inputs)\n",
    "\n",
    "        # Extract the CLS token embedding (the first token)\n",
    "        cls_embedding = outputs.last_hidden_state[:, 0, :].cpu()  # [batch_size, hidden_size]\n",
    "        embeddings.append(cls_embedding)\n",
    "\n",
    "    # Concatenate all embeddings into a single tensor\n",
    "    return torch.cat(embeddings, dim=0)\n",
    "\n",
    "# Device to use (GPU if available)\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "# Preprocessed data (from your earlier preprocessing code)\n",
    "train_texts = X_train.tolist()  # Assuming `X_train` contains the training texts\n",
    "test_texts = X_test.tolist()    # Assuming `X_test` contains the testing texts\n",
    "\n",
    "# Generate embeddings for training and testing data\n",
    "print(\"Generating embeddings for training data...\")\n",
    "train_embeddings = get_embeddings_with_progress(train_texts, tokenizer, model, device)\n",
    "\n",
    "print(\"Generating embeddings for testing data...\")\n",
    "test_embeddings = get_embeddings_with_progress(test_texts, tokenizer, model, device)\n",
    "\n",
    "# Convert embeddings to numpy arrays if needed\n",
    "train_embeddings_np = train_embeddings.cpu().numpy()\n",
    "test_embeddings_np = test_embeddings.cpu().numpy()\n",
    "\n",
    "# Print shapes of generated embeddings\n",
    "print(f\"Train Embeddings Shape: {train_embeddings_np.shape}\")\n",
    "print(f\"Test Embeddings Shape: {test_embeddings_np.shape}\")\n"
   ]
