    "def preprocess_data(df):\n",
    "    df['Class'] = df['Class'].str.lower()\n",
    "\n",
    "    def preprocess_text(text):\n",
    "        text = re.sub(r'http\\S+', '', text)  # Remove URLs\n",
    "        text = re.sub(r'[^a-zA-Z\\s]', '', text)  # Remove special characters\n",
    "        text = text.lower()  # Convert to lowercase\n",
    "        return text\n",
    "\n",
    "    # Apply the function to clean the text\n",
    "    df['Text_cleaned'] = df['Text'].apply(preprocess_text)\n",
    "    #print(df)\n",
    "    return df\n",
    "\n",
    "def split_data(df, test_size=0.2, random_state=42):\n",
    "    # Split into train and test datasets\n",
    "    X_train, X_test, y_train, y_test = train_test_split(\n",
    "        df['Text'], df['Class'], test_size=test_size, random_state=random_state\n",
    "    )\n",
    "    return X_train, X_test, y_train, y_test\n",
    "\n",
    "\n",
    "# File paths\n",
    "# File directories\n",
    "train_tamil_path = r\"/home/AWT_train.csv\"\n",
    "train_malayalam_path = r\"/home/AWM_train.csv\"\n",
    "dev_tamil_path = r\"/home/AWT_dev.csv\"\n",
    "dev_malayalam_path = r\"/home/AWM_dev.csv\"\n",
    "test_tamil_path = r\"/home/AWT_test_with_labels.csv\"\n",
    "test_malayalam_path = r\"/home/AWM_test_with_labels.csv\"\n",
    "\n",
    "# Load and preprocess the training data\n",
    "AWTtrain_tamil = pd.read_csv(train_tamil_path)\n",
    "AWTtrain_Tam = preprocess_data(AWTtrain_tamil)\n",
    "AWTtrain_malayalam = pd.read_csv(train_malayalam_path)\n",
    "AWTtrain_Mal = preprocess_data(AWTtrain_malayalam)\n",
    "\n",
    "# Load and preprocess the development data\n",
    "AWTDev_tamil = pd.read_csv(dev_tamil_path)\n",
    "AWTDev_Tam = preprocess_data(AWTDev_tamil)\n",
    "AWTDev_malayalam = pd.read_csv(dev_malayalam_path)\n",
    "AWTDev_Mal = preprocess_data(AWTDev_malayalam)\n",
    "\n",
    "# Load and preprocess the test data\n",
    "AWTTest_tamil = pd.read_csv(test_tamil_path)\n",
    "AWTTest_Tam = preprocess_data(AWTTest_tamil)\n",
    "AWTTest_malayalam = pd.read_csv(test_malayalam_path)\n",
    "AWTTest_Mal = preprocess_data(AWTTest_malayalam)\n",
    "\n",
    "# Define label mapping\n",
    "label_mapping = {'abusive': 1, 'non-abusive': 0}\n",
    "\n",
    "# Map labels to numerical values\n",
    "AWTtrain_Tam['Class'] = AWTtrain_Tam['Class'].map(label_mapping)\n",
    "AWTtrain_Mal['Class'] = AWTtrain_Mal['Class'].map(label_mapping)\n",
    "AWTDev_Tam['Class'] = AWTDev_Tam['Class'].map(label_mapping)\n",
    "AWTDev_Mal['Class'] = AWTDev_Mal['Class'].map(label_mapping)\n",
    "AWTTest_Tam['Class'] = AWTTest_Tam['Class'].map(label_mapping)\n",
    "AWTTest_Mal['Class'] = AWTTest_Mal['Class'].map(label_mapping)\n",
    "\n",
    "# Combine training and development data\n",
    "combined_train_data = pd.concat([AWTtrain_Tam, AWTtrain_Mal, AWTDev_Tam, AWTDev_Mal]).reset_index(drop=True)\n",
    "\n",
    "# Combine test data\n",
    "combined_test_data = pd.concat([AWTTest_Tam, AWTTest_Mal]).reset_index(drop=True)\n",
    "\n",
    "# Separate features and labels\n",
    "X_train = combined_train_data['Text']\n",
    "y_train = combined_train_data['Class']\n",
    "X_test = combined_test_data['Text']\n",
    "y_test = combined_test_data['Class']\n",
    "# Print data overview\n",
    "print(f\"Training data shape: {X_train.shape}, Test data shape: {X_test.shape}\")\n",
    "#print(f\"AWTtest_Tam data shape: {AWTtest_Tam.shape}\")\n",
    "#print(f\"AWTtest_Mal data shape: {AWTtest_Mal.shape}\")\n"
